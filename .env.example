# Environment Configuration
SECRET_KEY=CrowdStampede@2026
DATABASE_URL=sqlite:///database.db

# Email / OTP Settings (Optional: replace with your own Gmail credentials)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Model & Computer Vision Settings
YOLO_MODEL_NAME=yolov8n.pt
YOLO_CONFIDENCE=0.25
DEVICE=auto
FRAME_SKIP=1

# Soft-NMS Settings
SOFT_NMS_METHOD=gaussian
SOFT_NMS_SIGMA=0.5
SOFT_NMS_IOU_THRESHOLD=0.5
SOFT_NMS_CONF_THRESHOLD=0.25
